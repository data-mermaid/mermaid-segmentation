# Build context for docker/jobs/Dockerfile. The Dockerfile COPYs explicit directories, so this
# only keeps local state, secrets and VCS metadata out of the context.
.git
.venv
.env
logs
outputs
**/wandb
**/__pycache__
.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info
tests
slurm
docs
sagemaker
data
