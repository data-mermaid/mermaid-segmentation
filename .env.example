# Hugging Face (required for gated models like DINOv3)
# Create token at https://hf.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxx

# AWS Profile (recommended: use 'mermaid-core' profile for S3 access)
# AWS_PROFILE=mermaid-core

# AWS Credentials (if not using ~/.aws/credentials)
# Only needed if you're not using AWS profiles
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_DEFAULT_REGION=us-east-1

# CoralNet training manifest (optional). By default the CoralNet dataset reads the manifest
# built by the pinned ETL run. Set one of these to read a different build; the path wins.
# Full S3 key of the manifest parquet, relative to the source bucket
# MERMAID_CORALNET_MANIFEST_PATH=etl-outputs/coralnet/<version>/coralnet_training_manifest_<version>.parquet
# Version tag; reads etl-outputs/coralnet/<version>/coralnet_training_manifest_<version>.parquet
# MERMAID_CORALNET_MANIFEST_VERSION=<version>

# CoralNet scraper (packages/coralnet-scraper; see its README)
# Nothing loads .env for the scraper: export it first, for example `set -a; source .env; set +a`.
# Destination S3 bucket; required, no default
# MERMAID_CORALNET_BUCKET=<bucket>
# Key prefix under the bucket; default coralnet-public-images
# MERMAID_CORALNET_PREFIX=coralnet-public-images
# Concurrent image workers (integer >= 1); default is derived from the CPU count
# MERMAID_CORALNET_SCRAPER_WORKERS=16
# CoralNet login; the scraper prompts for both when either is unset
# CORALNET_USERNAME=your-coralnet-username
# CORALNET_PASSWORD=your-coralnet-password

# Weights & Biases (Slurm and local runs; configs/logger_config.yaml, `uv sync --extra slurm`)
# Create a key at https://wandb.ai/authorize
# WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used when wandb_entity in configs/logger_config.yaml is null; omit to use your default entity
# WANDB_ENTITY=your-team-or-username
# The project comes from wandb_project in configs/logger_config.yaml; WANDB_PROJECT has no effect.

# Offline data mode (AWS-free training)
# When set to 1, LocalS3Cache raises on any cache miss instead of contacting S3.
# The training SLURM job sets this; warm the cache first with
# scripts/prefetch_cache.py (the only step that needs AWS credentials).
# MERMAIDSEG_S3_OFFLINE=1

# Slurm launcher (slurm/launch_*.sh and slurm/train.sbatch)
# Site-specific values; keep them in the git-ignored .env, never in the repo.
# Scratch root; the job relocates HOME, uv, Hugging Face and pip caches under it
# MERMAIDSEG_SCRATCH=/path/to/scratch
# Pre-warmed local S3 cache directory passed to scripts/train.py --cache-dir
# MERMAIDSEG_CACHE_DIR=/path/to/scratch/cache
# Slurm account, QoS and partition passed to sbatch
# SLURM_ACCOUNT=your-account
# SLURM_QOS=your-qos
# SLURM_PARTITION=your-partition
# Directory for slurm-%x-%j.out/.err job logs (must exist)
# MERMAIDSEG_LOG_DIR=/path/to/scratch/logs
# Env file read by the launcher and batch jobs in place of <repo>/.env. Export it in the shell
# before running slurm/launch_*.sh; setting it inside .env has no effect.
# MERMAIDSEG_ENV_FILE=/path/to/env

# SageMaker launcher (make sm-validate, sm-dry-run, sm-launch; see README)
# The Makefile reads these from the environment, so load .env first (direnv, or
# `set -a; . ./.env; set +a`). Use your own account values; keep them out of the repo.
# IAM role ARN that the training job assumes
# SM_ROLE_ARN=arn:aws:iam::<account-id>:role/<job-role>
# S3 bucket for job output and checkpoints (s3://$SM_STAGING_BUCKET/runs/<job>/...)
# SM_STAGING_BUCKET=<staging-bucket>
# ECR registry that holds the training image
# SM_ECR_REGISTRY=<account-id>.dkr.ecr.<region>.amazonaws.com
# AWS profile the launcher uses to submit jobs
# SM_AWS_PROFILE=<profile>
# Secrets Manager secret ID that holds the Hugging Face token
# HF_TOKEN_SECRET_ID=<secret-id>
# ARN of the SageMaker MLflow tracking server the jobs log to; the launcher passes it to the job
# as MLFLOW_TRACKING_URI (configs/logger_config_sagemaker.yaml)
# SM_MLFLOW_TRACKING_ARN=arn:aws:sagemaker:<region>:<account-id>:mlflow-tracking-server/<name>
