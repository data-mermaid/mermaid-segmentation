# Hugging Face (required for gated models like DINOv3)
# Create token at https://hf.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxx

# AWS Configuration
# Uncomment and set if you want to override default bucket names
# MERMAID_BUCKET=coral-reef-training
# CORALNET_BUCKET=dev-datamermaid-sm-sources
# ML_RESEARCH_BUCKET=dev-datamermaid-ml-research  # mlflow-runs/, baselines/

# AWS Profile (recommended: use 'mermaid-core' profile for S3 access)
# AWS_PROFILE=mermaid-core

# AWS Credentials (if not using ~/.aws/credentials)
# Only needed if you're not using AWS profiles
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_DEFAULT_REGION=us-east-1

# MLflow Tracking (SageMaker MLflow App ARN, URL, or local path)
# Only needed for the (legacy) MLflow backend. The default training runs use
# wandb (see below) and need none of this.
# Set via: export MLFLOW_TRACKING_URI=arn:aws:sagemaker:us-east-1:123456789:mlflow-app/mermaid-mlflow
# Or set in a notebook cell: os.environ["MLFLOW_TRACKING_URI"] = "arn:..."
# MLFLOW_TRACKING_URI=arn:aws:sagemaker:us-east-1:123456789:mlflow-app/mermaid-mlflow

# Weights & Biases (default experiment-tracking backend)
# Create a key at https://wandb.ai/authorize
# WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WANDB_ENTITY=your-team-or-username        # optional; omit to use your default entity
# WANDB_PROJECT=mermaidseg                  # optional; overrides configs/logger_config.yaml

# Offline data mode (AWS-free training)
# When set to 1, LocalS3Cache raises on any cache miss instead of contacting S3.
# The training SLURM job sets this; warm the cache first with
# scripts/prefetch_cache.py (the only step that needs AWS credentials).
# MERMAIDSEG_S3_OFFLINE=1
